{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": [
    "index.js",
    "controllers/**/*.js",
    "utils/**/*.js",
    "libs/**/*.js",
    "libs_drpy/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "drpy-node-admin",
    "drpy-node-bundle",
    "drpy-node-mcp",
    "drpy2-quickjs",
    "apps",
    "public",
    "data",
    "spider",
    "**/*.ts",
    "**/*.tsx"
  ]
}
